<?xml version="1.0" encoding="utf-8"?>
<!--
    Home-screen now-playing widget.

    Deliberately flat: RemoteViews only supports a small set of layouts, and a
    widget that fails to inflate shows as "Problem loading widget" with no
    further explanation. Cover art on the left, two lines of text, three
    transport buttons — the same three the notification puts in its compact view.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#DD101012"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        android:src="@mipmap/ic_launcher" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingLeft="10dp"
        android:paddingEnd="6dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FFF2F2F2"
            android:textSize="14sp"
            android:text="@string/widget_nothing_playing" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#FF9A9A9F"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/widget_description"
        android:src="@android:drawable/ic_media_previous" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/widget_description"
        android:src="@android:drawable/ic_media_play" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/widget_description"
        android:src="@android:drawable/ic_media_next" />

</LinearLayout>
